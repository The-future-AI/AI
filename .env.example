# ─── Banco de dados (MySQL / TiDB compatível) ───────────────────────────────
# String de conexão usada pelo Drizzle ORM.
DATABASE_URL="mysql://user:password@host:4000/dbname?ssl={\"rejectUnauthorized\":true}"

# ─── Autenticação / Sessão ──────────────────────────────────────────────────
# Segredo usado para assinar os cookies de sessão (JWT). Use um valor longo e aleatório.
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"

# ─── OAuth (Manus) ──────────────────────────────────────────────────────────
OAUTH_SERVER_URL="https://api.manus.im"
OWNER_OPEN_ID=""
OWNER_NAME=""

# ─── LLM (Forge / compatível com OpenAI) ────────────────────────────────────
# Usado pelo pipeline para classificar categorias e agrupar tópicos.
BUILT_IN_FORGE_API_URL="https://forge.manus.ai"
BUILT_IN_FORGE_API_KEY=""

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
VITE_APP_ID=""
VITE_APP_TITLE="Notícias Brasil - Análise de Viés Político"
VITE_APP_LOGO=""
VITE_OAUTH_PORTAL_URL="https://manus.im"
VITE_FRONTEND_FORGE_API_URL="https://forge.manus.ai"
VITE_FRONTEND_FORGE_API_KEY=""

# ─── Analytics (opcional) ───────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
